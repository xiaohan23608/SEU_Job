<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>东南大学招聘信息</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-content">
            <a href="/" class="navbar-brand">东南大学招聘信息</a>
            <div class="navbar-actions">
                <% if (isAdmin) { %>
                    <a href="/admin" class="btn btn-sm btn-primary">管理后台</a>
                    <button id="logoutBtn" class="btn btn-sm">退出</button>
                <% } else { %>
                    <a href="/login" class="btn btn-sm">管理登录</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="search-bar">
            <input type="text" id="searchInput" class="search-input" placeholder="搜索招聘信息...">
            <button id="searchBtn" class="btn btn-primary btn-sm">搜索</button>
        </div>

        <div id="cardGrid" class="card-grid">
            <!-- 卡片将通过 JavaScript 动态生成 -->
        </div>

        <div id="pagination" class="pagination">
            <!-- 分页将通过 JavaScript 动态生成 -->
        </div>
    </div>

    <script src="/js/app.js"></script>
</body>
</html>
